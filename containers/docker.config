process {
    withName: '.*BALLGOWN.*' { container = 'rnaseq/ballgown:2.43.0' }
    withName: '.*BEDTOOLS.*' { container = 'rnaseq/bedtools:2.31.1' }
    withName: '.*CUFFLINKS.*' { container = 'rnaseq/cufflinks:2.2.1' }
    withName: '.*ENTREZ_DIRECT.*' { container = 'rnaseq/entrez-direct:26.6.20261102' }
    withName: '.*FASTP.*' { container = 'rnaseq/fastp:0.23.2' }
    withName: '.*FASTQC.*' { container = 'rnaseq/fastqc:0.11.9' }
    withName: '.*FASTQ_SCREEN.*' { container = 'rnaseq/fastq-screen:0.16.0' }
    withName: '.*GEDI.*' { container = 'rnaseq/gedi:1.0.6a' }
    withName: '.*MULTIQC.*' { container = 'rnaseq/multiqc:1.14' }
    withName: '.*RSEM.*' { container = 'rnaseq/rsem:1.3.3' }
    withName: '.*RUSTQC.*' { container = 'rnaseq/rustqc:0.2.1' }
    withName: '.*SALMON.*' { container = 'rnaseq/salmon:1.10.3' }
    withName: '.*SAMTOOLS.*' { container = 'rnaseq/samtools:1.19' }
    withName: '.*SEQKIT.*' { container = 'rnaseq/seqkit:2.14.0' }
    withName: '.*SRATOOLKIT.*' { container = 'rnaseq/sratoolkit:3.4.1' }
    withName: '.*STAR.*' { container = 'rnaseq/star:2.7.8a' }
    withName: '.*STRINGTIE.*' { container = 'rnaseq/stringtie:3.0.2' }
    withName: '.*SUBREAD.*' { container = 'rnaseq/subread:2.1.1' }
    withName: '.*UMICOLLAPSE.*' { container = 'rnaseq/umicollapse:1.1.0' }
}
