process {
    withName: '.*FASTP.*' {
        container = 'rnaseq/fastp:[info] 0.23.2'
    }
    withName: '.*FASTQC.*' {
        container = 'rnaseq/fastqc:[info] 0.11.9'
    }
    withName: '.*MULTIQC.*' {
        container = 'rnaseq/multiqc:[info] 1.14'
    }
    withName: '.*RUSTQC.*' {
        container = 'rnaseq/rustqc:0.2.1'
    }
    withName: '.*STAR.*' {
        container = 'rnaseq/star:[info] 2.7.8a'
    }
}
