process {
    withName: '.*FASTP.*' {
        container = "${projectDir}/containers/out/fastp-[info] 0.23.2.squashfs"
    }
    withName: '.*FASTQC.*' {
        container = "${projectDir}/containers/out/fastqc-[info] 0.11.9.squashfs"
    }
    withName: '.*MULTIQC.*' {
        container = "${projectDir}/containers/out/multiqc-[info] 1.14.squashfs"
    }
    withName: '.*RUSTQC.*' {
        container = "${projectDir}/containers/out/rustqc-0.2.1.squashfs"
    }
    withName: '.*STAR.*' {
        container = "${projectDir}/containers/out/star-[info] 2.7.8a.squashfs"
    }
}
