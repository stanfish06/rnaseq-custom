params {
    mode              = 'standard'
    input             = null
    outdir            = 'results'

    genomes           = null
    fasta             = null
    gtf               = null
    star_index        = null
    rsem_index        = null
    gedi_index        = null

    strandedness      = null
    quantifiers       = 'salmon,rsem,featurecounts'
    isoform           = null
    count_introns     = true
    gene_count_args   = '-t exon -g gene_id'
    intron_count_args = ''
    regions           = null
    contaminants      = null
    skip_rustqc       = false

    no4su_pattern     = null
    slam_prefix       = 'slam'

    download_source    = 'auto'
    download_max_reads = null
    download_max_runs  = null
    zenodo_pattern     = '\\.(fastq|fq)\\.gz$'
    zenodo_mate_regex  = '^(.+?)[._-]R?([12])(_001)?\\.(fastq|fq)\\.gz$'

    star_preset = 'default'
    star_encode_args = '--outSAMunmapped Within --outFilterType BySJout --outSAMattributes NH HI AS NM MD --outFilterMultimapNmax 20 --outFilterMismatchNmax 999 --outFilterMismatchNoverLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --sjdbScore 1 --quantMode TranscriptomeSAM GeneCounts --outSAMstrandField intronMotif --runRNGseed 0'
    star_args = [
        standard: '--quantMode TranscriptomeSAM GeneCounts --twopassMode Basic --outSAMattributes NH HI AS NM MD --outSAMstrandField intronMotif --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --runRNGseed 0',
        tag3p: '--outFilterIntronMotifs RemoveNoncanonical --outSAMunmapped Within --outSAMattributes NH HI AS NM MD --outFilterMultimapNmax 20 --runRNGseed 0',
        slamseq: '--alignEndsType EndToEnd --outSAMattributes NH HI AS NM MD --outSAMstrandField intronMotif --outFilterMultimapNmax 20 --runRNGseed 0',
    ]
    fastp_args = [
        qc: '--disable_adapter_trimming --disable_length_filtering',
        standard: '',
        tag3p: '--trim_poly_x --cut_tail --cut_tail_mean_quality 15 --length_required 25',
        slamseq: '',
    ]
    featurecounts_args = [
        standard: '-B -C',
        tag3p: '-O --fraction -M --fracOverlap 0.1 -Q 1',
        slamseq: '-B -C',
    ]
    gedi_slam_args = '-full -progress -D -trim5p 20 -trim3p 20 -snpConv 0.05 -modelall'
}

process {
    cpus       = 1
    memory     = 4.GB

    publishDir = [path: { "${params.outdir}/${task.ext.genome ? task.ext.genome + '/' : ''}${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]

    withName: 'STAR_.*|RSEM_.*|BEDTOOLS_.*|GEDI_.*|SAMTOOLS_.*|UMICOLLAPSE|SALMON_.*|SUBREAD_.*|STRINGTIE_.*|BALLGOWN|CUFFLINKS_.*|RUSTQC_.*|TXIMPORT_.*' {
        ext.genome = { params.genomes ? meta.genome : null }
    }

    withLabel: process_mono {
        cpus   = 1
        memory = 4.GB
    }
    withLabel: process_dual {
        cpus   = 2
        memory = 8.GB
    }
    withLabel: process_quad {
        cpus   = 4
        memory = 16.GB
    }
    withLabel: process_octa {
        cpus   = 8
        memory = 64.GB
    }

    withName: FASTP {
        ext.args = { params.fastp_args[params.mode] ?: '' }
    }
    withName: STAR_GENOMEGENERATE {
        ext.args = { "--genomeSAindexNbases ${Math.min(14, (Math.log(fasta.size()) / Math.log(2) / 2 - 1) as int)}" }
    }
    withName: STAR_ALIGN {
        ext.args = { params.star_preset == 'encode_standard' && params.mode == 'standard' ? params.star_encode_args : (params.star_args[params.mode] ?: '') }
    }
    withName: SUBREAD_FEATURECOUNTS {
        ext.args = { params.featurecounts_args[params.mode] ?: '' }
    }
    withName: GEDI_SLAM {
        ext.args = { params.gedi_slam_args }
    }
    withName: SRATOOLKIT_FASTERQDUMP {
        maxForks      = 4
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: SRATOOLKIT_SRASTAT {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

profiles {
    docker {
        process.shell     = ['/bin/bash', '-euo', 'pipefail']
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'
        docker.temp       = 'auto'
        includeConfig 'containers/docker.config'
    }
    singularity {
        process.shell          = ['/bin/bash', '-euo', 'pipefail']
        singularity.enabled    = true
        singularity.autoMounts = true
        includeConfig 'containers/singularity.config'
    }
    test {
        params.mode  = 'qc'
        params.input = "${projectDir}/assets/samplesheet.test.csv"
        params.gtf   = "${projectDir}/data/test/genome.exon.gtf"
        process {
            withName: RUSTQC_RNA {
                ext.args = '--skip-dup-check'
            }
            withName: MULTIQC {
                ext.args = "--ignore '*junction_annotation*'"
            }
        }
    }
    greatlakes {
        params.slurm_account = ''
        executor {
            queueSize       = 40
            submitRateLimit = '20/1min'
            pollInterval    = '1 min'
        }
        singularity.cacheDir = "${projectDir}/containers/out"
        process {
            executor       = 'slurm'
            queue          = 'standard'
            clusterOptions = { "--account=${params.slurm_account}" }
            resourceLimits = [cpus: 32, memory: 180.GB, time: 48.h]
            time           = { 4.h * task.attempt }
            errorStrategy  = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
            maxRetries     = 2
            withLabel: process_quad {
                memory = { 16.GB * task.attempt }
            }
            withLabel: process_octa {
                memory = { 64.GB * task.attempt }
            }
            withName: STAR_GENOMEGENERATE {
                cpus   = 16
                memory = { 96.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }
            withName: STAR_ALIGN {
                cpus   = 12
                memory = { 72.GB * task.attempt }
            }
            withName: UMICOLLAPSE {
                cpus   = 4
                memory = { 48.GB * task.attempt }
            }
            withName: FASTQ_SCREEN_INDEX {
                cpus   = 16
                memory = { 48.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
        }
    }
    smoke {
        params.fasta             = "${projectDir}/data/refs/smoke/chr22.fa"
        params.gtf               = "${projectDir}/data/refs/smoke/chr22.gtf"
        params.regions           = "${projectDir}/assets/regions.smoke.csv"
        params.contaminants      = "${projectDir}/assets/contaminants.smoke.csv"
        params.isoform           = 'stringtie,ballgown,cufflinks'
        params.download_max_reads = 20000
        params.download_max_runs  = 1
        process {
            resourceLimits = [cpus: 8, memory: 24.GB]
            withName: FASTQ_SCREEN {
                ext.args = '--subset 20000'
            }
            withName: RUSTQC_RNA {
                ext.args = '--skip-dup-check'
            }
        }
    }
}
