params {
    input  = null
    gtf    = null
    outdir = 'results'
}

process {
    cpus       = 1
    memory     = 4.GB

    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]

    withLabel: process_mono {
        cpus   = 1
        memory = 4.GB
    }
    withLabel: process_dual {
        cpus   = 2
        memory = 8.GB
    }
    withLabel: process_quad {
        cpus   = 4
        memory = 16.GB
    }
    withLabel: process_octa {
        cpus   = 8
        memory = 64.GB
    }
}

profiles {
    docker {
        process.shell     = ['/bin/bash', '-euo', 'pipefail']
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'
        docker.temp       = 'auto'
        includeConfig 'containers/docker.config'
    }
    singularity {
        process.shell          = ['/bin/bash', '-euo', 'pipefail']
        singularity.enabled    = true
        singularity.autoMounts = true
        includeConfig 'containers/singularity.config'
    }
    test {
        params.input = "${projectDir}/assets/samplesheet.test.csv"
        params.gtf   = "${projectDir}/data/test/genome.exon.gtf"
        process {
            withName: RUSTQC_RNA {
                ext.args = '--skip-dup-check'
            }
            withName: MULTIQC {
                ext.args = "--ignore '*junction_annotation*'"
            }
        }
    }
}
